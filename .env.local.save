# Copy this file to .env.local and fill in your values.

# Database (PostgreSQL). Get a free DB at e.g. Neon, Supabase, or Railway.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Access gate: password guests must enter to view the gallery.
# If unset, any password is accepted (demo only).
NEXT_PUBLIC_ACCESS_PASSWORD="your-secret-password"

# Optional: JWT secret for session signing. Change in production.
JWT_SECRET="your-jwt-secret-change-in-production"

# Optional: Order / contact links (used in Order This Artwork menu)
# NEXT_PUBLIC_WHATSAPP_NUMBER="905551234567"
# NEXT_PUBLIC_CONTACT_EMAIL="info@gallery.com"
# NEXT_PUBLIC_INSTAGRAM="gallernpm install

NEXT_PUBLIC_ACCESS_PASSWORD="gallery2024"
DATABASE_URL="postgresql://postgres:password@localhost:5432/art_g
